REMOTE_BIND=127.0.0.1:8787
REMOTE_DB=/var/lib/remote-platform/remote.db
REMOTE_ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_ADMIN_SECRET
REMOTE_ENROLL_TOKEN=CHANGE_TO_A_SEPARATE_LONG_RANDOM_ENROLL_SECRET
# Path to the Windows agent binary served for install.ps1 / silent updates
REMOTE_AGENT_EXE=/var/lib/darktask/remote-agent.exe
REMOTE_AGENT_VERSION=0.3.0
RUST_LOG=remote_server=info,tower_http=info
