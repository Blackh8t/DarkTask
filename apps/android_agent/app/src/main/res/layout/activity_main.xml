<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DarkTask"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android endpoint · no audio · low bandwidth"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Not enrolled"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Enter the server URL and enrollment token from the admin portal."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SERVER"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_field"
            android:hint="https://rust.privateserver.im"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="#4A5568"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ENROLLMENT TOKEN"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_field"
            android:hint="from the admin portal"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="#4A5568"
            android:textSize="14sp" />

        <Button
            android:id="@+id/enroll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Enroll and start"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grantScreen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Grant screen capture"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/grantInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Enable remote input"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Stop agent"
            android:textAllCaps="false"
            android:textColor="@color/danger" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Video only (no audio). Capture stays at the device resolution, then is downscaled to 1280px and JPEG 40 @ 12fps so the remote viewer stays fast."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
